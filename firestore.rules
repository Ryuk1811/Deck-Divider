rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is Super User / Admin
    function isSuperUser() {
      return isAuthenticated() && 
        ('email' in request.auth.token) &&
        request.auth.token.email.lower() == 'gurutvamurdia@gmail.com';
    }

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check route
    match /test/{document=**} {
      allow read: if true;
    }

    // Encrypted System Vault (Restricted to Super User & Firebase Admin SDK)
    match /system_vault/{document=**} {
      allow read, write: if isSuperUser();
    }

    match /system/{document=**} {
      allow read, write: if isSuperUser();
    }

    match /tcg_expansions/{setId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /tcg_cards/{cardId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /cardCatalog/{cardId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /expansions/{expansionId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /users/{userId} {
      allow read: if (isAuthenticated() && (isOwner(userId) || isSuperUser())) || (resource != null && (resource.data.isPublicProfile == true || resource.data.isPublic == true));
      allow create: if isAuthenticated() && isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['isSuperUser', 'role', 'isAdmin', 'tier', 'subscriptionPlan', 'plan']) || isSuperUser());
      allow update: if isAuthenticated() && (
        isSuperUser() || 
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperUser', 'role', 'isAdmin', 'tier', 'subscriptionPlan', 'plan']))
      );
      allow delete: if isSuperUser();

      match /snapshot/current {
        allow read: if (isAuthenticated() && isOwner(userId)) || isSuperUser() || 
          (resource != null && (resource.data.isPublicProfile == true || resource.data.isPublic == true)) ||
          (exists(/databases/$(database)/documents/users/$(userId)) && 
           (get(/databases/$(database)/documents/users/$(userId)).data.isPublicProfile == true || 
            get(/databases/$(database)/documents/users/$(userId)).data.isPublic == true));
        allow write: if (isAuthenticated() && isOwner(userId)) || isSuperUser();
      }

      match /backups/{backupId} {
        allow read, write: if (isAuthenticated() && isOwner(userId)) || isSuperUser();
      }

      match /decks/{deckId} {
        allow read, write: if (isAuthenticated() && isOwner(userId)) || isSuperUser();
      }

      match /customLists/{listId} {
        allow read, write: if (isAuthenticated() && isOwner(userId)) || isSuperUser();
      }

      match /sealedVault/{entryId} {
        allow read, write: if (isAuthenticated() && isOwner(userId)) || isSuperUser();
      }

      match /{allSubcollections=**} {
        allow read, write: if (isAuthenticated() && isOwner(userId)) || isSuperUser();
      }
    }
    
    // Subscriptions collection: strictly read-only for users; server Admin SDK & SuperUser manage billing records
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      allow write: if isSuperUser();
    }
    
    match /decks/{deckId} {
      allow read: if (isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid || isSuperUser())) || (resource != null && resource.data.isPublic == true);
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
    }
    
    match /portfolioItems/{itemId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
    }

    match /listItems/{itemId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
    }
    
    match /customLists/{listId} {
      allow read: if (isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid || isSuperUser())) || (resource != null && resource.data.isPublic == true);
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
    }

    // Community Reviews collection (Public Read, Public Submission with validation, SuperUser moderation)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is number && 
                      request.resource.data.rating >= 1 && 
                      request.resource.data.rating <= 5 && 
                      request.resource.data.comment is string && 
                      request.resource.data.comment.size() > 0 && 
                      request.resource.data.comment.size() <= 2000;
      allow update, delete: if isSuperUser() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
