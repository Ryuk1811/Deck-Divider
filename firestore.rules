rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Check if user is Super User / Admin
    function isSuperUser() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'gurutvamurdia@gmail.com'
      );
    }

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /tcg_expansions/{setId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /tcg_cards/{cardId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /cardCatalog/{cardId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /expansions/{expansionId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      allow create: if isAuthenticated() && isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['isSuperUser', 'role']) || isSuperUser());
      allow update: if isAuthenticated() && isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperUser', 'role']) || isSuperUser());
      allow delete: if isSuperUser();

      match /{allSubcollections=**} {
        allow read, write: if (isAuthenticated() && isOwner(userId)) || isSuperUser();
      }
    }
    
    // Subscriptions collection: locked write to Admin / Super User ONLY
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      allow write: if isSuperUser(); 
    }
    
    match /decks/{deckId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true || isSuperUser());
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
    }
    
    match /portfolioItems/{itemId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
    }

    match /listItems/{itemId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
    }
    
    match /customLists/{listId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperUser());
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isSuperUser());
    }
  }
}
