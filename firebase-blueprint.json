{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "displayCurrency": { "type": "string" },
        "isSuperUser": { "type": "boolean" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "User subscription status, governor period, and tier entitlements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tierName": { "type": "string" },
        "effectiveTier": { "type": "string" },
        "isSuperUser": { "type": "boolean" },
        "billingStatus": { "type": "string" },
        "paymentType": { "type": "string" },
        "provider": { "type": "string" },
        "currentPeriodStart": { "type": "string" },
        "currentPeriodEnd": { "type": "string" },
        "daysRemaining": { "type": "number" },
        "isExpired": { "type": "boolean" },
        "razorpayPaymentId": { "type": "string" },
        "razorpayOrderId": { "type": "string" },
        "paypalSubscriptionId": { "type": "string" },
        "updatedAt": { "type": "string" },
        "governorNote": { "type": "string" }
      },
      "required": ["id", "tierName"]
    },
    "UserCompressedSnapshot": {
      "title": "UserCompressedSnapshot",
      "description": "High-efficiency micro-compressed snapshot of the entire user state",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" },
        "byteSize": { "type": "number" },
        "rawSize": { "type": "number" },
        "compressionRatio": { "type": "string" },
        "summary": { "type": "object" },
        "compressedPayload": { "type": "string" }
      },
      "required": ["version", "userId", "updatedAt", "compressedPayload"]
    },
    "Deck": {
      "title": "Deck",
      "description": "Deck container with card entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "colorHex": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "entries": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "CustomList": {
      "title": "CustomList",
      "description": "Custom card lists and want-lists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "cardIds": { "type": "array" },
        "coverImageUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "SealedVaultEntry": {
      "title": "SealedVaultEntry",
      "description": "Sealed Booster Boxes, ETBs, and Bundle vault items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "product": { "type": "object" },
        "quantity": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "purchaseCurrency": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "condition": { "type": "string" },
        "notes": { "type": "string" },
        "isSold": { "type": "boolean" },
        "salePrice": { "type": "number" }
      }
    },
    "SystemVaultRecord": {
      "title": "SystemVaultRecord",
      "description": "AES-256-GCM encrypted server credentials and environment secrets vault",
      "type": "object",
      "properties": {
        "iv": { "type": "string" },
        "ciphertext": { "type": "string" },
        "authTag": { "type": "string" },
        "encryptedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "version": { "type": "string" },
        "storedKeys": { "type": "array" }
      },
      "required": ["iv", "ciphertext", "authTag"]
    },
    "Review": {
      "title": "Review",
      "description": "Public community trainer review and rating document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "category": { "type": "string" },
        "userRole": { "type": "string" },
        "createdAt": { "type": "string" },
        "likesCount": { "type": "number" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public community trainer review collection"
    },
    "/system_vault/{documentId}": {
      "schema": { "$ref": "#/entities/SystemVaultRecord" },
      "description": "AES-256-GCM encrypted system secrets and environment credentials"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents"
    },
    "/users/{userId}/snapshot/current": {
      "schema": { "$ref": "#/entities/UserCompressedSnapshot" },
      "description": "Single-document space-efficient compressed user state snapshot"
    },
    "/subscriptions/{userId}": {
      "schema": { "$ref": "#/entities/SubscriptionRecord" },
      "description": "User tier and billing subscription records"
    },
    "/users/{userId}/decks/{deckId}": {
      "schema": { "$ref": "#/entities/Deck" },
      "description": "User created decks subcollection"
    },
    "/users/{userId}/customLists/{listId}": {
      "schema": { "$ref": "#/entities/CustomList" },
      "description": "User created custom lists subcollection"
    },
    "/users/{userId}/sealedVault/{sealedId}": {
      "schema": { "$ref": "#/entities/SealedVaultEntry" },
      "description": "User sealed vault assets subcollection"
    },
    "/decks/{deckId}": {
      "schema": { "$ref": "#/entities/Deck" },
      "description": "Shared root decks collection"
    }
  }
}
