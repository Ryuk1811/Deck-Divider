{
  "name": "deck-divider",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "icons": "tsx scripts/generateAllIcons.ts",
    "build": "tsx scripts/generateAllIcons.ts && vite build && tsx scripts/prerender.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pages": "tsx scripts/generateAllIcons.ts && vite build && tsx scripts/prerender.ts",
    "build:worker": "vite build",
    "deploy:pages": "tsx scripts/generateAllIcons.ts && vite build && tsx scripts/prerender.ts && wrangler pages deploy dist --project-name=deck-divider",
    "deploy:worker": "vite build && wrangler deploy",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@google/genai": "^2.4.0",
    "@orama/orama": "^3.1.18",
    "@paypal/paypal-js": "^10.1.0",
    "@paypal/react-paypal-js": "^10.3.0",
    "@sentry/node": "^10.72.0",
    "@sentry/profiling-node": "^10.72.0",
    "@sentry/react": "^10.72.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@tcgdex/sdk": "^2.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.4.21",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "got-scraping": "^4.2.1",
    "idb": "^8.0.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "puppeteer": "^25.5.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sharp": "^0.32.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.126.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7"
  }
}
